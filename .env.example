# =========================================================================
# IUCEE KARE Student Chapter (IKSC) Certificate Verification Environment
# =========================================================================

# The deployed production URL (used to generate valid QR codes)
# e.g. https://iksc-verification.vercel.app or https://verify.iksc.org
VITE_PUBLIC_DOMAIN=

# Your Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Anonymous Public API Key (Safe for client browsers)
# Found in: Supabase Dashboard > Project Settings > API > anon public
VITE_SUPABASE_ANON_KEY=
